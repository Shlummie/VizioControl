{
  "name": "viziocontrol",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A local-first Vizio SmartCast controller with restricted GPT-5.6 Luna TV navigation.",
  "main": "dist-electron/main.cjs",
  "author": "VizioControl",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build:icon && cross-env NODE_ENV=production npm run build && node scripts/package-windows.mjs && node scripts/finalize-release.mjs",
    "package:dir": "npm run build:icon && cross-env NODE_ENV=production npm run build && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "@openai/codex": "0.147.0",
    "bonjour-service": "^1.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.viziocontrol.desktop",
    "productName": "VizioControl",
    "artifactName": "${productName} ${version} ${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc",
        "to": "codex"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "VizioControl Setup 1.0.0.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VizioControl",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "VizioControl 1.0.0 Portable.exe"
    }
  }
}
